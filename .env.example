# 默认离线演示；在线模式需显式设置 live。应用读取环境变量，不自动加载本文件。
GAME_NPC_MODE=demo
GAME_NPC_RETRIEVAL=local
# 请使用绝对路径；默认 ~/.game-npc
# GAME_NPC_STATE_DIR=/absolute/path/to/Agent_1/.runtime
# GAME_NPC_DATA_DIR=/absolute/path/to/knowledge
# GAME_NPC_PROFILE_PATH=/absolute/path/to/npc.json
# GAME_NPC_WORLD_PATH=/absolute/path/to/world_pack_or_world.json

# 多模型：qwen | deepseek | kimi | openai | grok | glm | openrouter | claude | custom
GAME_NPC_PROVIDER=qwen
# 统一密钥（优先）；也可改用各提供商专用变量
# GAME_NPC_API_KEY=your-key
# DASHSCOPE_API_KEY= / DEEPSEEK_API_KEY= / MOONSHOT_API_KEY= / OPENAI_API_KEY=
# XAI_API_KEY= / ZHIPUAI_API_KEY= / OPENROUTER_API_KEY=

# 可选覆盖；留空则使用提供商预设
# GAME_NPC_BASE_URL=https://api.deepseek.com/v1
# GAME_NPC_MODEL=deepseek-chat
# GAME_NPC_EMBEDDING_MODEL=text-embedding-3-small
