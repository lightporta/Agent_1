# 默认离线演示；在线模式需显式设置 live。应用读取环境变量，不自动加载本文件。
GAME_NPC_MODE=demo
GAME_NPC_RETRIEVAL=local
# 请使用绝对路径；默认 ~/.game-npc
# GAME_NPC_STATE_DIR=/absolute/path/to/Agent_1/.runtime
# GAME_NPC_DATA_DIR=/absolute/path/to/knowledge
# 在线模式使用通义千问 OpenAI 兼容接口
# DASHSCOPE_API_KEY=your-key
GAME_NPC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GAME_NPC_MODEL=qwen3-max
GAME_NPC_EMBEDDING_MODEL=text-embedding-v4
